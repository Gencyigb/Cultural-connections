extends layouts/layout.pug

block content
  .auth-container
    .auth-card
      .auth-header
        h1 Join Cultural Connections
        p Share your culture with the world
      
      if error
        .error-message
          span ⚠️
          span= error
      
      form.auth-form(action="/register", method="POST")
        .form-row
          .form-group
            label(for="name") Full Name
            input(type="text", id="name", name="name", placeholder="Your name", required)
          
          .form-group
            label(for="country") Country
            input(type="text", id="country", name="country", placeholder="Your country")
        
        .form-row
          .form-group
            label(for="email") Email Address
            input(type="email", id="email", name="email", placeholder="you@example.com", required)
          
          .form-group
            label(for="password") Password
            input(type="password", id="password", name="password", placeholder="••••••••", required)
        
        .form-group
          label(for="language") Languages Spoken
          input(type="text", id="language", name="language", placeholder="e.g., English, Spanish")
        
        .form-group
          label(for="interests") Cultural Interests
          input(type="text", id="interests", name="interests", placeholder="e.g., Food, Traditions, Music")
        
        .form-group
          label(for="bio") Short Bio
          textarea(id="bio", name="bio", rows="3", placeholder="Tell us about yourself and your culture...")
        
        button.auth-btn(type="submit") Create Account
      
      .auth-footer
        p Already have an account? 
          a(href="/login") Sign in here
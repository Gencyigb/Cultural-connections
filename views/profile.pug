extends layouts/layout.pug

block content
  if user
    .profile-container
      .country-flag-emoji(style="font-size: 80px; text-align: center; margin-bottom: 15px;") 🌍
      
      h1(style="text-align: center;")= user.name
      
      .profile-info
        p <strong>📍 Country:</strong> #{user.country}
        p <strong>🗣️ Languages:</strong> #{user.language || 'Not specified'}
        p <strong>🎯 Interests:</strong> #{user.interests || 'Not specified'}
        p <strong>💬 Bio:</strong> #{user.bio || 'Not specified'}
      
      if countryInfo
        hr
        h3 Country Information
        .country-info-box
          p <strong>🏛️ Capital:</strong> #{countryInfo.capital || 'N/A'}
          p <strong>👥 Population:</strong> #{countryInfo.population || 'N/A'}
          p <strong>🌎 Region:</strong> #{countryInfo.region || 'N/A'}
      
      a.btn.back-button(href="/users") ← Back to all users
  else
    p User not found